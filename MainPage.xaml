<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AiCoder.Models"
             xmlns:strings="clr-namespace:AiCoder.Resources.Strings"
             xmlns:converters="clr-namespace:AiCoder.Converters"
             x:Class="AiCoder.MainPage"
             Title="{x:Static strings:AppResources.AppTitle}">

    <ContentPage.Resources>
        <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:TextBlockVisibilityConverter x:Key="TextBlockVisibilityConverter" />
        <converters:ToolBlockVisibilityConverter x:Key="ToolBlockVisibilityConverter" />
        <converters:InverseCountToBoolConverter x:Key="InverseCountToBoolConverter" />

        <Style x:Key="MessageBubble" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="MaximumWidthRequest" Value="720" />
        </Style>

        <Style x:Key="ToolCard" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style x:Key="AttachmentCard" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8E8E8, Dark=#3A3A3A}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="260,*">

        <!-- 左侧会话列表 -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Padding="10" RowSpacing="8"
              BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}">

            <Button Text="{x:Static strings:AppResources.NewSession}" Clicked="NewConversation_Click" />

            <CollectionView x:Name="ConversationList" Grid.Row="1"
                            SelectionMode="Single"
                            SelectionChanged="ConversationList_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Conversation">
                        <Grid Padding="6" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Title}" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Provider.Name}" FontSize="11"
                                       TextColor="Gray" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="✕" FontSize="11"
                                    WidthRequest="28" HeightRequest="28" Padding="0"
                                    BackgroundColor="Transparent" TextColor="Gray"
                                    Clicked="DeleteConversation_Click"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Grid.Row="2" Text="{x:Static strings:AppResources.ManageProviders}" Clicked="ManageProviders_Click" />
        </Grid>

        <!-- 右侧聊天区 -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Padding="12,12,12,8" RowSpacing="8">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label x:Name="HeaderLabel" Grid.Column="0"
                       Text="{x:Static strings:AppResources.NoSessionSelected}"
                       FontAttributes="Bold" LineBreakMode="TailTruncation"
                       VerticalOptions="Center" />
                <Picker x:Name="LanguagePicker" Grid.Column="1" WidthRequest="110"
                        SelectedIndexChanged="LanguagePicker_SelectedIndexChanged" />
            </Grid>

            <CollectionView x:Name="ChatList" Grid.Row="1">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <Grid>
                            <Border Style="{StaticResource MessageBubble}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Role}" Value="User">
                                        <Setter Property="HorizontalOptions" Value="End" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#DCF8C6, Dark=#2E5A3A}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Role}" Value="Assistant">
                                        <Setter Property="HorizontalOptions" Value="Start" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#2D2D2D}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Role}" Value="Tool">
                                        <Setter Property="HorizontalOptions" Value="Center" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF3CD, Dark=#5A4A2A}" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding RoleLabel}" FontSize="11"
                                           TextColor="Gray" FontAttributes="Bold"
                                           IsVisible="{Binding HasText}" />

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Blocks}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:MessageBlock">
                                                <VerticalStackLayout Spacing="6">
                                                    <Label Text="{Binding Text}" LineBreakMode="WordWrap"
                                                           IsVisible="{Binding Type, Converter={StaticResource TextBlockVisibilityConverter}}" />

                                                    <Border Style="{StaticResource ToolCard}"
                                                            IsVisible="{Binding Type, Converter={StaticResource ToolBlockVisibilityConverter}}"
                                                            BackgroundColor="{AppThemeBinding Light=#E8F0FE, Dark=#1A3A5C}">
                                                        <VerticalStackLayout Spacing="4">
                                                            <Label Text="{Binding ToolCard.Name}" FontAttributes="Bold" FontSize="12" TextColor="Gray" />
                                                            <Label Text="{Binding ToolCard.CallContent}" FontSize="12" LineBreakMode="WordWrap" />
                                                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#C5C5C5, Dark=#555}" 
                                                                     IsVisible="{Binding ToolCard.HasResult}" />
                                                            <Label Text="{Binding ToolCard.ResultContent}" FontSize="12" LineBreakMode="WordWrap"
                                                                   IsVisible="{Binding ToolCard.HasResult}" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Label Text="{Binding DisplayText}" LineBreakMode="WordWrap"
                                           IsVisible="{Binding Blocks.Count, Converter={StaticResource InverseCountToBoolConverter}}" />

                                    <Image Source="{Binding ImageSource}"
                                           Aspect="AspectFit"
                                           MaximumHeightRequest="220"
                                           MaximumWidthRequest="360"
                                           HorizontalOptions="Start"
                                           IsVisible="{Binding HasImage}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 输入区 -->
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                  ColumnSpacing="6" RowSpacing="6">

                <!-- 附件预览 -->
                <CollectionView x:Name="AttachmentList" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"
                                ItemsLayout="HorizontalList"
                                HeightRequest="68">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PendingAttachment">
                            <Border Style="{StaticResource AttachmentCard}">
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                    <Image Source="{Binding Thumbnail}" Aspect="AspectFill"
                                           WidthRequest="44" HeightRequest="44"
                                           IsVisible="{Binding IsImage}" />
                                    <Label Text="📄" FontSize="28" VerticalOptions="Center"
                                           IsVisible="{Binding IsImage, Converter={StaticResource InverseBoolConverter}}" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" WidthRequest="120">
                                        <Label Text="{Binding FileName}" FontSize="12" LineBreakMode="TailTruncation" />
                                        <Button Text="{x:Static strings:AppResources.RemoveAttachment}" FontSize="11"
                                                Padding="4,2" HeightRequest="28"
                                                Clicked="RemoveAttachment_Click"
                                                CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- 按钮 + 输入框 -->
                <Button Grid.Row="1" Grid.Column="0" Text="{x:Static strings:AppResources.AttachImage}"
                        Clicked="AttachImage_Click" />
                <Button Grid.Row="1" Grid.Column="1" Text="{x:Static strings:AppResources.AttachFile}"
                        Clicked="AttachFile_Click" />
                <Button Grid.Row="1" Grid.Column="2" Text="{x:Static strings:AppResources.TakePhoto}"
                        Clicked="CaptureImage_Click" />

                <Editor x:Name="InputBox" Grid.Row="1" Grid.Column="3"
                        Placeholder="{x:Static strings:AppResources.EnterYourMessages}"
                        AutoSize="TextChanges"
                        MaximumHeightRequest="160"
                        VerticalOptions="End" />

                <VerticalStackLayout Grid.Row="1" Grid.Column="4" Spacing="6">
                    <Button x:Name="MicButton"
                            Text="{x:Static strings:AppResources.SpeechToText}"
                            Clicked="MicButton_Click" />
                    <Button x:Name="SendButton"
                            Text="{x:Static strings:AppResources.Send}"
                            Clicked="Send_Click" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
