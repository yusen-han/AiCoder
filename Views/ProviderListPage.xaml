<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AiCoder.Models"
             xmlns:strings="clr-namespace:AiCoder.Resources.Strings"
             x:Class="AiCoder.Views.ProviderListPage"
             Title="{x:Static strings:AppResources.ModelProviders}">
    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="10">

        <Label Text="{x:Static strings:AppResources.ModelProviders}" FontSize="22" FontAttributes="Bold" />

        <CollectionView x:Name="ProviderList" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ProviderConfig">
                    <Border Margin="0,4" Padding="10" StrokeShape="RoundRectangle 6">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding Model}" FontSize="11" TextColor="Gray" />
                                <Label Text="{Binding Kind}" FontSize="10" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="{x:Static strings:AppResources.Edit}" Padding="10,4"
                                    Clicked="Edit_Click" CommandParameter="{Binding .}" />
                            <Button Grid.Column="2" Text="{x:Static strings:AppResources.Delete}" Padding="10,4"
                                    Clicked="Delete_Click" CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0" Text="{x:Static strings:AppResources.AddProvider}" Clicked="Add_Click" />
            <Button Grid.Column="1" Text="{x:Static strings:AppResources.Close}" Clicked="Close_Click" />
        </Grid>
    </Grid>
</ContentPage>
