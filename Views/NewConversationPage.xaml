<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:AiCoder.Resources.Strings"
             x:Class="AiCoder.Views.NewConversationPage"
             Title="{x:Static strings:AppResources.CreateNewSession}">
    <VerticalStackLayout Padding="20" Spacing="14" VerticalOptions="Center">

        <Label Text="{x:Static strings:AppResources.CreateNewSession}" FontSize="22" FontAttributes="Bold" />

        <Label Text="{x:Static strings:AppResources.ModelProviders}" FontAttributes="Bold" />
        <Picker x:Name="ProviderPicker" Title="{x:Static strings:AppResources.SelectModelProvider}" />

        <Label Text="{x:Static strings:AppResources.ToolCallingPattern}" FontAttributes="Bold" />
        <Picker x:Name="ToolModePicker" SelectedIndex="0" />

        <Button Text="{x:Static strings:AppResources.ManageProviders}" Clicked="Manage_Click"
                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#0078D4, Dark=#4CC2FF}" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
            <Button Grid.Column="0" Text="{x:Static strings:AppResources.Cancel}" Clicked="Cancel_Click" />
            <Button Grid.Column="1" Text="{x:Static strings:AppResources.StartYourChat}" Clicked="Create_Click" />
        </Grid>
    </VerticalStackLayout>
</ContentPage>
