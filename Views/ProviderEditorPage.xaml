<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:AiCoder.Resources.Strings"
             x:Class="AiCoder.Views.ProviderEditorPage"
             Title="{x:Static strings:AppResources.ProvidersConfig}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="{x:Static strings:AppResources.ProvidersConfig}" FontSize="22" FontAttributes="Bold" />

            <Label Text="{x:Static strings:AppResources.DisplayName}" FontAttributes="Bold" />
            <Entry x:Name="NameBox" Placeholder="{x:Static strings:AppResources.DisplayNamePlaceholder}" />

            <Label Text="{x:Static strings:AppResources.InterfaceType}" FontAttributes="Bold" />
            <Picker x:Name="KindPicker" SelectedIndexChanged="KindPicker_SelectedIndexChanged" />

            <Label Text="{x:Static strings:AppResources.EndpointBaseUrl}" FontAttributes="Bold" />
            <Entry x:Name="EndpointBox" Keyboard="Url" />

            <Label Text="{x:Static strings:AppResources.ApiKey}" FontAttributes="Bold" />
            <Entry x:Name="ApiKeyBox" IsPassword="True" />

            <Label Text="{x:Static strings:AppResources.ModelName}" FontAttributes="Bold" />
            <Entry x:Name="ModelBox" Placeholder="{x:Static strings:AppResources.ModelNamePlaceholder}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,16,0,0">
                <Button Grid.Column="0" Text="{x:Static strings:AppResources.Cancel}" Clicked="Cancel_Click" />
                <Button Grid.Column="1" Text="{x:Static strings:AppResources.Save}" Clicked="Save_Click" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
